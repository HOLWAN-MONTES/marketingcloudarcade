      <!-- SECTION 8 · ARCADE CHALLENGE -->
      <h2 id="challenge">08 · ARCADE CHALLENGE: YOUR FIRST DYNAMIC GREETING</h2>
      <div class="challenge-box">
        <div class="challenge-badge">🕹️ ARCADE CHALLENGE · LEVEL 1</div>
        <div class="challenge-title">Build a Personalized Greeting Block</div>
        <div class="challenge-desc">
          Create an AMPscript block that processes subscriber name (<code>FirstName</code>) and loyalty tier (<code>Tier</code>).
          <ul>
            <li>If the name exists, format it in <strong>ProperCase</strong>; if blank, use the fallback <em>"Valued Member"</em>.</li>
            <li>If <code>Tier</code> is <strong>"VIP"</strong>, assign a 20% discount. If <strong>"Gold"</strong>, assign 10%. Otherwise, assign 5%.</li>
            <li>Output the greeting and discount voucher in the HTML.</li>
          </ul>
        </div>

        <details class="challenge-details">
          <summary class="challenge-summary">▶ View Challenge Solution and Breakdown</summary>
          <div class="challenge-solution">
            <div class="code-block">
              <div class="code-header">
                <span class="code-lang">FULL AMPSCRIPT SOLUTION</span>
                <button class="btn-copy" onclick="navigator.clipboard.writeText(this.closest('.code-block').querySelector('pre').innerText); this.textContent='COPIED!'; setTimeout(()=>this.textContent='COPY',2000);">COPY</button>
              </div>
              <pre><code class="language-ampscript">%%[
  /* 1. Declare all variables */
  VAR @rawName, @formattedName, @tier, @discountPercent

  /* 2. Safely extract subscriber data */
  SET @rawName = AttributeValue("FirstName")
  SET @tier = AttributeValue("Tier")

  /* 3. Validate and format name with Empty() */
  IF NOT EMPTY(@rawName) THEN
    SET @formattedName = ProperCase(@rawName)
  ELSE
    SET @formattedName = "Valued Member"
  ENDIF

  /* 4. Evaluate tier and assign discount */
  IF @tier == "VIP" THEN
    SET @discountPercent = 20
  ELSEIF @tier == "Gold" THEN
    SET @discountPercent = 10
  ELSE
    SET @discountPercent = 5
  ENDIF
]%%

&lt;!-- Rendered HTML --&gt;
&lt;div style="background:#1a1d2e; border:1px solid #00ffff; border-radius:8px; padding:20px; font-family:sans-serif; color:#ffffff;"&gt;
  &lt;h2 style="color:#00ffff; margin-top:0;"&gt;Hello, %%=v(@formattedName)=%%!&lt;/h2&gt;
  &lt;p&gt;As a valued member of our community, you have a special perk:&lt;/p&gt;
  &lt;div style="font-size:24px; font-weight:bold; color:#ff00ff;"&gt;
    🎟️ %%=v(@discountPercent)=%% % OFF
  &lt;/div&gt;
&lt;/div&gt;</code></pre>
            </div>
            <p style="margin-top:0.8rem; font-size:0.85rem; color:var(--text-secondary);">
              <strong>Breakdown:</strong> We use <code>AttributeValue()</code> to prevent send errors on missing fields. With <code>IF NOT EMPTY()</code> we format the name using <code>ProperCase()</code>, and finally evaluate <code>@tier</code> with clean conditional statements.
            </p>
          </div>
        </details>
      </div>

