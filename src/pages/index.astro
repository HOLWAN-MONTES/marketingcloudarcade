  // Generate pixel stars
  const starsEl = document.getElementById('stars');
  if (starsEl) {
    for (let i = 0; i < 60; i++) {
      const star = document.createElement('div');
      star.className = 'star';
      star.style.cssText = `
        left:${Math.random()*100}%;
        top:${Math.random()*100}%;
        --d:${2 + Math.random()*4}s;
        --delay:${Math.random()*4}s;
        opacity:${0.1 + Math.random()*0.5};
      `;
      starsEl.appendChild(star);
    }
  }

  // Fetch catalog.html to dynamically calculate and update category counts
  document.addEventListener('DOMContentLoaded', () => {
    fetch('/catalog')
      .then(res => res.text())
      .then(html => {
        const parser = new DOMParser();
        const doc = parser.parseFromString(html, 'text/html');
        const cards = doc.querySelectorAll('#articles-grid .article-card');
        
        const counts = { all: cards.length, categories: new Set() };
        const articleLinks = new Set();

        cards.forEach(card => {
          const cat = card.getAttribute('data-category');
          if (cat) {
            counts[cat] = (counts[cat] || 0) + 1;
            counts.categories.add(cat);
          }
          const href = card.getAttribute('href');
          if (href) articleLinks.add(href);
        });

        // Update category cards
        document.querySelectorAll('.category-card').forEach(catCard => {
          const href = catCard.getAttribute('href');
          if (href && href.includes('?cat=')) {
            const cat = href.split('?cat=')[1];
            const span = catCard.querySelector('.category-count span:first-child');
            if (span && counts[cat] !== undefined) {
              span.textContent = counts[cat];
            } else if (span && counts[cat] === undefined && cat !== 'changelog') {
              span.textContent = '0'; 
            }
          }
        });

        // Dynamic Featured Articles
        const featuredContainer = document.getElementById('featured-articles-container');
        if (featuredContainer) {
          const featuredCards = Array.from(cards).filter(c => c.getAttribute('data-featured') === 'true');
          if (featuredCards.length > 0) {
            featuredContainer.innerHTML = ''; // Clear fallback content

            const icons = {}; // Now using window.getCategoryIcon instead

            // Reverse order if we want the first marked to be the big one, or just take as is
            featuredCards.slice(0, 3).forEach((card, index) => {
              const clone = card.cloneNode(true);
              
              // Ensure href points properly from index
              const originalHref = clone.getAttribute('href');
              if (originalHref && !originalHref.startsWith('pages/') && !originalHref.startsWith('http')) {
                clone.setAttribute('href', originalHref);
              }

              if (index === 0) {
                // First card becomes the big featured card
                clone.classList.add('featured-card');
                clone.style.gridColumn = 'span 2';
                clone.style.gridTemplateColumns = 'auto 1fr';
                
                const cat = clone.getAttribute('data-category');
                const visualHTML = window.getCategoryIcon(cat, 64) || '<span style="font-size:3.5rem;">🕹️</span>';
                
                const visualDiv = document.createElement('div');
                visualDiv.className = 'featured-card-visual';
                visualDiv.innerHTML = visualHTML;
                
                const bodyDiv = document.createElement('div');
                bodyDiv.className = 'featured-card-body';
                
                // Move inner content to bodyDiv
                while (clone.firstChild) {
                  bodyDiv.appendChild(clone.firstChild);
                }
                
                clone.appendChild(visualDiv);
                clone.appendChild(bodyDiv);
              }

              featuredContainer.appendChild(clone);
            });
            
            // Re-apply language to newly injected cards
            if (typeof LangManager !== 'undefined') {
              LangManager.apply(localStorage.getItem('mca-lang') || 'es');
            }

            // Dynamic Recently Added Articles
            const recentlyAddedContainer = document.getElementById('recently-added-container');
            if (recentlyAddedContainer) {
              const months = { Jan:0, Feb:1, Mar:2, Apr:3, May:4, Jun:5, Jul:6, Aug:7, Sep:8, Oct:9, Nov:10, Dec:11 };
              const parseDateStr = (str) => {
                const clean = (str || '').replace('📅', '').trim();
                const [month, year] = clean.split(' ');
                return new Date(parseInt(year) || 2025, months[month] || 0, 1);
              };

              const sortedCards = Array.from(cards).sort((a, b) => {
                const dateA = parseDateStr(a.querySelector('.article-card-footer span:nth-child(2)')?.textContent || '');
                const dateB = parseDateStr(b.querySelector('.article-card-footer span:nth-child(2)')?.textContent || '');
                return dateB - dateA; // Sort descending (latest first)
              });

              if (sortedCards.length > 0) {
                recentlyAddedContainer.innerHTML = ''; // Clear fallback content
                sortedCards.slice(0, 3).forEach(card => {
                  const clone = card.cloneNode(true);
                  const originalHref = clone.getAttribute('href');
                  if (originalHref && !originalHref.startsWith('pages/') && !originalHref.startsWith('http')) {
                    clone.setAttribute('href', originalHref);
                  }
                  recentlyAddedContainer.appendChild(clone);
                });
              }
            }

            // Sync real view counts from Firebase for the dynamically loaded cards
            if (typeof window.loadRealViews === 'function') {
              window.loadRealViews();
            }
          }
        }

        // Calculate dynamic stats
        const categoryCount = counts.categories.size;
        
        // Count available languages from the toggle switch
        const langCount = document.querySelectorAll('.lang-text').length || 2;

        // Fetch all articles to count snippets (.code-block)
        Promise.all(Array.from(articleLinks).map(link => 
          fetch(link).then(r => r.text()).catch(() => '')
        )).then(pagesHtml => {
          let snippetCount = 0;
          pagesHtml.forEach(html => {
            // Count occurrences of 'class="code-block"' instead of parsing full DOM for speed
            const matches = html.match(/class="code-block"/g);
            if (matches) snippetCount += matches.length;
          });

          // Update main stats counter
          const statValues = document.querySelectorAll('.stat-item .stat-value');
          if (statValues.length >= 4) {
            // [0] Articles
            statValues[0].setAttribute('data-target', counts.all);
            if (statValues[0].textContent !== '0') statValues[0].textContent = counts.all;
            
            // [1] Categories
            statValues[1].setAttribute('data-target', categoryCount);
            if (statValues[1].textContent !== '0') statValues[1].textContent = categoryCount;
            
            // [2] Snippets
            statValues[2].setAttribute('data-target', snippetCount);
            if (statValues[2].textContent !== '0') statValues[2].textContent = snippetCount;
            
            // [3] Languages
            statValues[3].setAttribute('data-target', langCount);
            if (statValues[3].textContent !== '0') statValues[3].textContent = langCount;
          }
        });
      })
      .catch(err => console.log('Error loading dynamic counts', err));
  });

  </script>
</Layout>
