          <div style="display:flex;justify-content:center;color:var(--neon-cyan);"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="12" y1="2" x2="12" y2="18"></line><polyline points="18 12 12 18 6 12"></polyline></svg></div>

          <!-- Outcome -->
          <div style="background:rgba(0,255,136,0.08);border:1.5px solid var(--neon-green);border-radius:6px;padding:0.8rem;text-align:center;">
