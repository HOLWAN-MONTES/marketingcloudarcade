---
// src/pages/catalog.astro
import Layout from "../layouts/Layout.astro";
import { getCategoryIcon } from "../config/icons.js";
import { ALL_CARDS } from "../config/articles.js";

// Pre-calculate count tags for server side rendering
const counts = {
  all: ALL_CARDS.length,
  ssjs: ALL_CARDS.filter((c) => c.category === "ssjs").length,
  ampscript: ALL_CARDS.filter((c) => c.category === "ampscript").length,
  sql: ALL_CARDS.filter((c) => c.category === "sql").length,
  automation: ALL_CARDS.filter((c) => c.category === "automation").length,
  journey: ALL_CARDS.filter((c) => c.category === "journey").length,
  cloudpages: ALL_CARDS.filter((c) => c.category === "cloudpages").length,
  innovations: ALL_CARDS.filter((c) => c.category === "innovations").length,
  resources: ALL_CARDS.filter((c) => c.category === "resources").length,
  "mc-next": ALL_CARDS.filter((c) => c.category === "mc-next").length,
};
---

<Layout title="Catálogo | Marketing Cloud Arcade">
  <div class="catalog-hero">
    <div class="catalog-hero-inner">
      <h1 data-lang="es">📂 CATÁLOGO COMPLETO</h1>
      <h1 data-lang="en">📂 FULL CATALOG</h1>
      <p data-lang="es">
        Todos los artículos, snippets y guías de Marketing Cloud Arcade. Filtra
        por categoría, nivel o busca lo que necesitas.
      </p>
      <p data-lang="en">
        All articles, snippets and guides from Marketing Cloud Arcade. Filter by
        category, level or search for what you need.
      </p>
    </div>
  </div>

  <div class="catalog-layout">
    <!-- SIDEBAR -->
    <aside class="catalog-sidebar">
      <nav class="sidebar-nav">
        <div class="sidebar-nav-header" data-lang="es">CATEGORÍAS</div>
        <div class="sidebar-nav-header" data-lang="en">CATEGORIES</div>

        <!-- ALL CATEGORIES -->
        <a
          class="sidebar-nav-item active"
          href="#"
          data-filter="all"
          id="cat-btn-all"
          onclick="filterCat(event,'all')"
        >
          <span>🗂️</span>
          <span data-lang="es">Todos</span>
          <span data-lang="en">All</span>
          <span class="count">{counts.all}</span>
        </a>

        <!-- AMPscript Category Group -->
        <div class="sidebar-nav-group" data-category="ampscript">
          <a
            class="sidebar-nav-item parent-item"
            href="#"
            data-filter="ampscript"
            onclick="toggleCategoryGroup(event,'ampscript')"
          >
            <span class="chevron-arrow">▶</span>
            <span set:html={getCategoryIcon("ampscript", 16)} />
            <span class="cat-label">AMPscript</span>
            <span class="count">{counts.ampscript}</span>
          </a>
          <ul
            class="sidebar-sub-items"
            id="sub-ampscript"
            style="display: none;"
          >
          </ul>
        </div>

        <!-- Automation Studio Group -->
        <div class="sidebar-nav-group" data-category="automation">
          <a
            class="sidebar-nav-item parent-item"
            href="#"
            data-filter="automation"
            onclick="toggleCategoryGroup(event,'automation')"
          >
            <span class="chevron-arrow">▶</span>
            <span set:html={getCategoryIcon("automation", 16)} />
            <span class="cat-label">Automation Studio</span>
            <span class="count">{counts.automation}</span>
          </a>
          <ul
            class="sidebar-sub-items"
            id="sub-automation"
            style="display: none;"
          >
          </ul>
        </div>

        <!-- Cloud Pages Group -->
        <div class="sidebar-nav-group" data-category="cloudpages">
          <a
            class="sidebar-nav-item parent-item"
            href="#"
            data-filter="cloudpages"
            onclick="toggleCategoryGroup(event,'cloudpages')"
          >
            <span class="chevron-arrow">▶</span>
            <span set:html={getCategoryIcon("cloudpages", 16)} />
            <span class="cat-label">Cloud Pages</span>
            <span class="count">{counts.cloudpages}</span>
          </a>
          <ul
            class="sidebar-sub-items"
            id="sub-cloudpages"
            style="display: none;"
          >
          </ul>
        </div>

        <!-- Innovations Group -->
        <div class="sidebar-nav-group" data-category="innovations">
          <a
            class="sidebar-nav-item parent-item"
            href="#"
            data-filter="innovations"
            onclick="toggleCategoryGroup(event,'innovations')"
          >
            <span class="chevron-arrow">▶</span>
            <span set:html={getCategoryIcon("innovations", 16)} />
            <span class="cat-label">
              <span data-lang="es">Innovaciones</span>
              <span data-lang="en">Innovations</span>
            </span>
            <span class="count">{counts.innovations}</span>
          </a>
          <ul
            class="sidebar-sub-items"
            id="sub-innovations"
            style="display: none;"
          >
          </ul>
        </div>

        <!-- Journey Builder Group -->
        <div class="sidebar-nav-group" data-category="journey">
          <a
            class="sidebar-nav-item parent-item"
            href="#"
            data-filter="journey"
            onclick="toggleCategoryGroup(event,'journey')"
          >
            <span class="chevron-arrow">▶</span>
            <span set:html={getCategoryIcon("journey", 16)} />
            <span class="cat-label">Journey Builder</span>
            <span class="count">{counts.journey}</span>
          </a>
          <ul class="sidebar-sub-items" id="sub-journey" style="display: none;">
          </ul>
        </div>

        <!-- MC Next Group -->
        <div class="sidebar-nav-group" data-category="mc-next">
          <a
            class="sidebar-nav-item parent-item"
            href="#"
            data-filter="mc-next"
            onclick="toggleCategoryGroup(event,'mc-next')"
          >
            <span class="chevron-arrow">▶</span>
            <span set:html={getCategoryIcon("mc-next", 16)} />
            <span class="cat-label">
              <span style="color:#bd93f9;font-weight:700;">MC Next ✨</span>
            </span>
            <span class="count">{counts["mc-next"]}</span>
          </a>
          <ul class="sidebar-sub-items" id="sub-mc-next" style="display: none;">
          </ul>
        </div>

        <!-- Resources Group -->
        <div class="sidebar-nav-group" data-category="resources">
          <a
            class="sidebar-nav-item parent-item"
            href="#"
            data-filter="resources"
            onclick="toggleCategoryGroup(event,'resources')"
          >
            <span class="chevron-arrow">▶</span>
            <span set:html={getCategoryIcon("resources", 16)} />
            <span class="cat-label">
              <span data-lang="es">Recursos</span>
              <span data-lang="en">Resources</span>
            </span>
            <span class="count">{counts.resources}</span>
          </a>
          <ul
            class="sidebar-sub-items"
            id="sub-resources"
            style="display: none;"
          >
          </ul>
        </div>

        <!-- SQL Category Group -->
        <div class="sidebar-nav-group" data-category="sql">
          <a
            class="sidebar-nav-item parent-item"
            href="#"
            data-filter="sql"
            onclick="toggleCategoryGroup(event,'sql')"
          >
            <span class="chevron-arrow">▶</span>
            <span set:html={getCategoryIcon("sql", 16)} />
            <span class="cat-label">SQL</span>
            <span class="count">{counts.sql}</span>
          </a>
          <ul class="sidebar-sub-items" id="sub-sql" style="display: none;">
          </ul>
        </div>

        <!-- SSJS Category Group -->
        <div class="sidebar-nav-group" data-category="ssjs">
          <a
            class="sidebar-nav-item parent-item"
            href="#"
            data-filter="ssjs"
            onclick="toggleCategoryGroup(event,'ssjs')"
          >
            <span class="chevron-arrow">▶</span>
            <span set:html={getCategoryIcon("ssjs", 16)} />
            <span class="cat-label">SSJS</span>
            <span class="count">{counts.ssjs}</span>
          </a>
          <ul class="sidebar-sub-items" id="sub-ssjs" style="display: none;">
          </ul>
        </div>
      </nav>
    </aside>

    <!-- MAIN PANEL -->
    <main>
      <!-- Search inline -->
      <div class="search-bar-inline">
        <span class="icon">🔍</span>
        <input
          id="catalog-search"
          type="text"
          placeholder="Filtrar artículos... / Filter articles..."
        />
      </div>

      <!-- Controls container: Level filter + Grid/List switcher -->
      <div class="filter-controls-container">
        <div class="level-filter">
          <button class="filter-btn active" data-filter-level="all">
            <span data-lang="es">Todos los niveles</span>
            <span data-lang="en">All levels</span>
          </button>
          <button class="filter-btn" data-filter-level="beginner"
            >🟢 Beginner</button
          >
          <button class="filter-btn" data-filter-level="intermediate"
            >🟡 Intermediate</button
          >
          <button class="filter-btn" data-filter-level="advanced"
            >🔴 Advanced</button
          >
        </div>

        <!-- View layout switcher -->
        <div class="layout-toggle">
          <button
            class="layout-btn active"
            id="layout-grid"
            onclick="switchLayout('grid')"
            title="Cuadrícula / Grid"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><rect x="3" y="3" width="7" height="7"></rect><rect
                x="14"
                y="3"
                width="7"
                height="7"></rect><rect x="14" y="14" width="7" height="7"
              ></rect><rect x="3" y="14" width="7" height="7"></rect></svg
            >
          </button>
          <button
            class="layout-btn"
            id="layout-list"
            onclick="switchLayout('list')"
            title="Lista / List"
          >
            <svg
              width="16"
              height="16"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><line x1="8" y1="6" x2="21" y2="6"></line><line
                x1="8"
                y1="12"
                x2="21"
                y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line
                x1="3"
                y1="6"
                x2="3.01"
                y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"
              ></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg
            >
          </button>
        </div>
      </div>

      <!-- Header count & tag status -->
      <div class="catalog-main-header">
        <div
          class="catalog-filters"
          style="margin:0;flex-wrap:wrap;gap:0.4rem;"
        >
          <span class="tag pink" id="active-cat-label" data-lang="es"
            >Todos</span
          >
          <span class="tag pink" id="active-cat-label-en" data-lang="en"
            >All</span
          >
          <span
            class="tag yellow"
            id="active-tag-label"
            style="display:none; cursor:pointer;"
            onclick="clearTagFilter()"
            title="Limpiar filtro / Clear filter"
            >#<span id="active-tag-text"></span> &nbsp;✖</span
          >
        </div>
        <div class="catalog-count">
          <span id="visible-count">{counts.all}</span>
          <span data-lang="es">artículos</span><span data-lang="en"
            >articles</span>
        </div>
      </div>

      <!-- CARDS GRID -->
      <div class="articles-grid" id="articles-grid">
        {
          ALL_CARDS.map((card) => (
            <a
              class="article-card"
              href={card.url}
              data-article-id={card.id}
              data-category={card.category}
              data-level={card.level}
              data-title={`${card.title_es} ${card.title_en} ${card.tags.join(" ")}`.toLowerCase()}
              data-featured={card.featured ? "true" : undefined}
            >
              <div class="article-card-top">
                <span class="tag pink">{card.category.toUpperCase()}</span>
                {card.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
                <span class={`level-badge ${card.level}`}>
                  {card.level === "beginner" && "🟢 Beginner"}
                  {card.level === "intermediate" && "🟡 Intermediate"}
                  {card.level === "advanced" && "🔴 Advanced"}
                </span>
              </div>

              <div class="article-card-title" data-lang="es">
                {card.title_es}
              </div>
              <div class="article-card-title" data-lang="en">
                {card.title_en}
              </div>

              <div class="article-card-desc" data-lang="es">
                {card.desc_es}
              </div>
              <div class="article-card-desc" data-lang="en">
                {card.desc_en}
              </div>

              <div class="article-card-footer">
                <span>⏱️ {card.duration}</span>
                <span>📅 {card.date}</span>
                <span class={`views ${card.hot ? "hot" : ""}`}>
                  {card.hot ? "🔥" : "👁️"}{" "}
                  <span data-random-views>-</span>
                </span>
              </div>
            </a>
          ))
        }
      </div><!-- /articles-grid -->

      <!-- PAGINATION -->
      <div
        class="pagination-container"
        id="pagination-container"
        style="display: none;"
      >
        <button id="load-more-btn" class="pagination-btn">
          <span
            class="btn-active-content"
            style="display: inline-flex; align-items: center; gap: 0.5rem;"
          >
            <span class="btn-icon">📥</span>
            <span data-lang="es">Cargar más artículos</span>
            <span data-lang="en">Load more articles</span>
          </span>
          <span
            class="btn-loaded-content"
            style="display: none; align-items: center; gap: 0.5rem;"
          >
            <span class="btn-icon-loaded">☑</span>
            <span data-lang="es">Todos cargados</span>
            <span data-lang="en">All loaded</span>
          </span>
        </button>
        <div class="pagination-status">
          <span data-lang="es"
            >Mostrando <span class="current-loaded">0</span> de <span
              class="total-matches">0</span
            > artículos</span
          >
          <span data-lang="en"
            >Showing <span class="current-loaded">0</span> of <span
              class="total-matches">0</span
            > articles</span
          >
        </div>
      </div>

      <div class="no-results" id="no-results">
        <span class="emoji">👾</span>
        <span data-lang="es">Sin resultados. Intenta otro filtro.</span>
        <span data-lang="en">No results. Try another filter.</span>
      </div>
    </main>
  </div>

  <!-- STYLES (is:global is required to style runtime elements in Astro) -->
  <style is:global>
    /* Chevron arrow rotation */
    .chevron-arrow {
      display: inline-block;
      font-size: 0.6rem;
      margin-right: 0.5rem;
      transition: transform var(--transition);
      color: var(--text-muted);
    }
    .sidebar-nav-group.expanded .chevron-arrow {
      transform: rotate(90deg) !important;
      color: var(--neon-cyan);
    }

    /* Sidebar Group Separators */
    .sidebar-nav-group {
      border-bottom: 1px solid var(--border-dim);
      display: block;
      width: 100%;
    }
    .sidebar-nav-group:last-child {
      border-bottom: none;
    }
    .sidebar-nav-group .sidebar-nav-item {
      border-bottom: none !important;
    }

    /* Sub-items list container */
    .sidebar-sub-items {
      list-style: none !important;
      padding: 0.25rem 0 0.5rem 0 !important;
      margin: 0 !important;
      background: rgba(0, 0, 0, 0.15) !important;
      border-top: 1px solid rgba(42, 42, 85, 0.2) !important;
      width: 100%;
    }

    /* Individual sub-item link */
    .sidebar-sub-item {
      display: flex !important;
      align-items: center !important;
      padding: 0.4rem 1rem 0.4rem 2.4rem !important; /* Exactly 2.4rem indentation */
      font-family: var(--font-mono) !important;
      font-size: 0.72rem !important;
      color: var(--text-secondary) !important; /* Override global <a> color */
      transition: all var(--transition) !important;
      border-left: 3px solid transparent !important;
      text-decoration: none !important;
      cursor: pointer !important;
      width: 100% !important;
      box-sizing: border-box !important;
    }

    .sidebar-sub-item .conector {
      font-family: var(--font-mono) !important;
      color: var(--text-muted) !important;
      margin-right: 6px !important;
      flex-shrink: 0 !important;
    }

    /* Level dots */
    .sub-item-dot {
      width: 6px !important;
      height: 6px !important;
      border-radius: 50% !important;
      display: inline-block !important;
      margin-right: 8px !important;
      flex-shrink: 0 !important;
    }
    .sub-item-dot.dot-beginner {
      background-color: var(--neon-green) !important;
      box-shadow: var(--glow-green) !important;
    }
    .sub-item-dot.dot-intermediate {
      background-color: var(--neon-yellow) !important;
      box-shadow: var(--glow-yellow) !important;
    }
    .sub-item-dot.dot-advanced {
      background-color: var(--neon-pink) !important;
      box-shadow: var(--glow-pink) !important;
    }

    /* Sub-item text wrapper for ellipsis truncation */
    .sub-item-title {
      white-space: nowrap !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      flex: 1 !important;
      text-align: left !important;
      color: inherit !important;
    }

    /* Sub-item states */
    .sidebar-sub-item:hover,
    .sidebar-sub-item.active {
      color: var(--neon-cyan) !important;
      background: rgba(0, 255, 255, 0.05) !important;
      border-left-color: var(--neon-cyan) !important;
      padding-left: 2.6rem !important; /* Slight responsive shift */
    }
    .sidebar-sub-item.active {
      background: rgba(0, 255, 255, 0.08) !important;
      font-weight: 600 !important;
    }

    /* Glowing Highlight Animation for selected Card */
    @keyframes card-glow-pulse {
      0% {
        outline: 2px solid var(--neon-cyan);
        box-shadow:
          0 0 15px var(--neon-cyan),
          var(--glow-cyan);
        transform: scale(1.02);
      }
      50% {
        outline: 2px solid var(--neon-cyan);
        box-shadow:
          0 0 25px var(--neon-cyan),
          var(--glow-cyan);
        transform: scale(1.025);
      }
      100% {
        outline: 2px solid transparent;
        box-shadow: none;
        transform: scale(1);
      }
    }
    .article-card.highlighted {
      animation: card-glow-pulse 1.8s ease-out !important;
      z-index: 10 !important;
    }

    /* Layout Switcher */
    .filter-controls-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1.25rem;
      flex-wrap: wrap;
      gap: 1rem;
    }
    .filter-controls-container .level-filter {
      margin-bottom: 0;
    }
    .layout-toggle {
      display: flex;
      background: var(--bg-secondary);
      border: 1px solid var(--border-strong);
      border-radius: var(--radius);
      padding: 2px;
    }
    .layout-btn {
      background: transparent;
      border: none;
      color: var(--text-secondary);
      padding: 0.4rem 0.6rem;
      cursor: pointer;
      border-radius: calc(var(--radius) - 1px);
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all var(--transition);
    }
    .layout-btn:hover {
      color: var(--neon-cyan);
    }
    .layout-btn.active {
      background: rgba(0, 255, 255, 0.15);
      color: var(--neon-cyan);
      box-shadow: 0 0 8px rgba(0, 255, 255, 0.1);
    }

    /* Smooth grids */
    .articles-grid {
      transition: all 0.3s ease-in-out;
    }
    .article-card {
      transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* List View Specific Layout Styles */
    .articles-grid.list-view {
      grid-template-columns: 1fr !important;
      gap: 1rem;
    }

    .articles-grid.list-view .article-card {
      display: flex;
      flex-direction: row !important;
      align-items: center !important;
      justify-content: space-between !important;
      gap: 1.5rem !important;
      padding: 1.25rem 1.5rem !important;
      min-height: 100px;
    }

    .articles-grid.list-view .article-card-top {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-start !important;
      gap: 0.4rem !important;
      width: 150px !important;
      flex-shrink: 0 !important;
    }

    .articles-grid.list-view .article-card-top .level-badge {
      margin-left: 0 !important;
    }

    .articles-grid.list-view .article-card-title {
      flex: 1 !important;
      font-size: 1.05rem !important;
      margin: 0 !important;
    }

    .articles-grid.list-view .article-card-desc {
      display: none !important;
    }

    .articles-grid.list-view .article-card-footer {
      display: flex !important;
      flex-direction: column !important;
      align-items: flex-end !important;
      gap: 0.4rem !important;
      border-top: none !important;
      padding-top: 0 !important;
      width: 120px !important;
      flex-shrink: 0 !important;
      font-family: var(--font-mono);
      font-size: 0.72rem;
    }

    .articles-grid.list-view .article-card-footer .views {
      margin-left: 0 !important;
    }

    @media (max-width: 768px) {
      .articles-grid.list-view .article-card {
        flex-direction: column !important;
        align-items: flex-start !important;
        gap: 1rem !important;
        min-height: auto !important;
      }
      .articles-grid.list-view .article-card-top {
        width: 100% !important;
        flex-direction: row !important;
        align-items: center !important;
      }
      .articles-grid.list-view .article-card-top .level-badge {
        margin-left: auto !important;
      }
      .articles-grid.list-view .article-card-footer {
        width: 100% !important;
        flex-direction: row !important;
        justify-content: space-between !important;
        border-top: 1px solid var(--border-dim) !important;
        padding-top: 0.75rem !important;
        align-items: center !important;
      }
    }

    /* Class-based filtering override */
    .article-card.hidden {
      display: none !important;
    }

    /* Pagination Styles */
    .pagination-container {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin: 3rem 0 1.5rem 0;
      gap: 0.75rem;
      width: 100%;
    }

    .pagination-btn {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      background: rgba(0, 0, 0, 0.4);
      border: 1px solid var(--neon-cyan);
      border-radius: var(--radius);
      padding: 0.75rem 1.75rem;
      color: var(--neon-cyan);
      font-family: var(--font-mono);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      transition: all var(--transition);
      box-shadow: 0 0 12px rgba(0, 255, 255, 0.1);
    }

    .pagination-btn:hover:not(:disabled) {
      background: rgba(0, 255, 255, 0.08);
      box-shadow:
        0 0 18px rgba(0, 255, 255, 0.25),
        var(--glow-cyan);
      transform: translateY(-2px);
    }

    .pagination-btn:active:not(:disabled) {
      transform: translateY(0);
    }

    .pagination-btn:disabled {
      border-color: var(--border-strong);
      color: var(--text-muted);
      cursor: default;
      box-shadow: none;
      background: rgba(42, 42, 85, 0.1);
    }

    .pagination-btn .btn-icon-loaded {
      color: var(--neon-green);
      text-shadow: var(--glow-green);
    }

    .pagination-status {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: var(--text-muted);
      text-align: center;
    }
  </style>

  <!-- SCRIPTS -->
  <script is:inline define:vars={{ ALL_CARDS }}>
    let currentCat = "all";
    let currentLevel = "all";
    let currentSearch = "";
    let currentTag = "all";
    let currentLayout = "grid";
    let visibleLimit = 6;

    // ── Reconstruct and render sidebar sub-items ──
    window.renderSidebarSubItems = function (lang) {
      // Group cards by category
      const grouped = {};
      ALL_CARDS.forEach((card) => {
        if (!grouped[card.category]) {
          grouped[card.category] = [];
        }
        grouped[card.category].push(card);
      });

      // Populate list elements in sidebar
      Object.keys(grouped).forEach((cat) => {
        const listEl = document.getElementById(`sub-${cat}`);
        if (!listEl) return;

        const cards = grouped[cat];
        listEl.innerHTML = cards
          .map((card) => {
            const title = lang === "es" ? card.title_es : card.title_en;

            let dotClass = "dot-beginner";
            if (card.level === "intermediate") dotClass = "dot-intermediate";
            if (card.level === "advanced") dotClass = "dot-advanced";

            return `
            <li>
              <a href="#" class="sidebar-sub-item" onclick="handleSubItemClick(event, '${card.id}', '${card.category}')">
                <span class="conector">└</span>
                <span class="sub-item-dot ${dotClass}"></span>
                <span class="sub-item-title" title="${title}">${title}</span>
              </a>
            </li>
          `;
          })
          .join("");
      });
    };

    // ── Dynamic Category Counts ──
    function updateCategoryCounts() {
      const counts = { all: ALL_CARDS.length };

      ALL_CARDS.forEach((card) => {
        if (card.category) {
          counts[card.category] = (counts[card.category] || 0) + 1;
        }
      });

      // Update counters in sidebar items
      document.querySelectorAll(".sidebar-nav-item").forEach((item) => {
        const filter = item.getAttribute("data-filter");
        const countSpan = item.querySelector(".count");
        if (countSpan && counts[filter] !== undefined) {
          countSpan.textContent = counts[filter];
        }
      });
    }

    // ── Sidebar Category Group Toggle ──
    window.toggleCategoryGroup = function (e, cat) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }

      const groupEl = document.querySelector(
        `.sidebar-nav-group[data-category="${cat}"]`,
      );
      if (!groupEl) return;

      const isExpanded = groupEl.classList.contains("expanded");

      // Collapse all groups
      document.querySelectorAll(".sidebar-nav-group").forEach((el) => {
        el.classList.remove("expanded");
        const sub = el.querySelector(".sidebar-sub-items");
        if (sub) sub.style.display = "none";
      });

      // Deactivate all sidebar nav active highlights
      document
        .querySelectorAll(".sidebar-nav-item")
        .forEach((el) => el.classList.remove("active"));

      if (!isExpanded) {
        // Expand target group
        groupEl.classList.add("expanded");
        const sub = groupEl.querySelector(".sidebar-sub-items");
        if (sub) sub.style.display = "block";

        // Set active state on header
        const header = groupEl.querySelector(".sidebar-nav-item");
        if (header) header.classList.add("active");

        // Apply filtering
        applyCatFilter(cat);
      } else {
        // Collapse and restore to all
        const allBtn = document.getElementById("cat-btn-all");
        if (allBtn) allBtn.classList.add("active");
        applyCatFilter("all");
      }
    };

    // ── Sidebar Category Header Filter ──
    window.filterCat = function (e, cat) {
      if (e) {
        e.preventDefault();
      }

      // Collapse all groups
      document.querySelectorAll(".sidebar-nav-group").forEach((el) => {
        el.classList.remove("expanded");
        const sub = el.querySelector(".sidebar-sub-items");
        if (sub) sub.style.display = "none";
      });

      // Reset active states
      document
        .querySelectorAll(".sidebar-nav-item")
        .forEach((el) => el.classList.remove("active"));

      if (cat === "all") {
        const allBtn = document.getElementById("cat-btn-all");
        if (allBtn) allBtn.classList.add("active");
      } else {
        const header = document.querySelector(
          `.sidebar-nav-group[data-category="${cat}"] .sidebar-nav-item`,
        );
        if (header) header.classList.add("active");

        // Also expand the group when category is clicked
        const groupEl = document.querySelector(
          `.sidebar-nav-group[data-category="${cat}"]`,
        );
        if (groupEl) {
          groupEl.classList.add("expanded");
          const sub = groupEl.querySelector(".sidebar-sub-items");
          if (sub) sub.style.display = "block";
        }
      }

      applyCatFilter(cat);
    };

    // ── Apply Category Filter State ──
    window.applyCatFilter = function (cat) {
      currentCat = cat;
      visibleLimit = 6; // Reset pagination limit on category filter
      applyFilters();

      // Seamlessly synchronize browser URL without page reload
      const url = new URL(window.location);
      if (cat && cat !== "all") {
        url.searchParams.set("cat", cat);
      } else {
        url.searchParams.delete("cat");
      }
      window.history.replaceState({ cat }, "", url.toString());

      // Update Navbar active indicator
      if (typeof window.initNavbarActive === "function") {
        window.initNavbarActive();
      }

      const labelES = document.getElementById("active-cat-label");
      const labelEN = document.getElementById("active-cat-label-en");
      const catLabels = {
        all: { es: "Todos", en: "All" },
        ssjs: { es: "SSJS", en: "SSJS" },
        ampscript: { es: "AMPscript", en: "AMPscript" },
        sql: { es: "SQL", en: "SQL" },
        automation: { es: "Automation Studio", en: "Automation Studio" },
        journey: { es: "Journey Builder", en: "Journey Builder" },
        cloudpages: { es: "Cloud Pages", en: "Cloud Pages" },
        innovations: { es: "Innovaciones", en: "Innovations" },
        resources: { es: "Recursos", en: "Resources" },
        "mc-next": { es: "Marketing Cloud Next", en: "Marketing Cloud Next" },
      };
      if (labelES) labelES.textContent = (catLabels[cat] || catLabels.all).es;
      if (labelEN) labelEN.textContent = (catLabels[cat] || catLabels.all).en;
    };

    // ── Smart Sub-Item Clicking & Highlighting ──
    window.handleSubItemClick = function (e, cardId, category) {
      if (e) {
        e.preventDefault();
        e.stopPropagation();
      }

      // Filter grid to matching category first
      applyCatFilter(category);

      // Temporarily override limit to show all matching category articles so the clicked article card is visible
      visibleLimit = ALL_CARDS.length;

      // Keep matching group expanded and highlighted in the sidebar
      document.querySelectorAll(".sidebar-nav-group").forEach((el) => {
        if (el.getAttribute("data-category") === category) {
          el.classList.add("expanded");
          const sub = el.querySelector(".sidebar-sub-items");
          if (sub) sub.style.display = "block";
          const header = el.querySelector(".sidebar-nav-item");
          if (header) header.classList.add("active");
        } else {
          el.classList.remove("expanded");
          const sub = el.querySelector(".sidebar-sub-items");
          if (sub) sub.style.display = "none";
        }
      });

      // Mark the sub-item link itself as active
      document
        .querySelectorAll(".sidebar-sub-item")
        .forEach((el) => el.classList.remove("active"));
      e.currentTarget.classList.add("active");

      applyFilters();

      // Scroll to specific article card & highlight
      const cardEl = document.querySelector(
        `.article-card[data-article-id="${cardId}"]`,
      );
      if (cardEl) {
        setTimeout(() => {
          cardEl.scrollIntoView({ behavior: "smooth", block: "center" });

          // Apply temporary 1.8s cyan border + glow pulse
          cardEl.classList.remove("highlighted");
          void cardEl.offsetWidth; // Force DOM repaint
          cardEl.classList.add("highlighted");

          setTimeout(() => {
            cardEl.classList.remove("highlighted");
          }, 1800);
        }, 80);
      }
    };

    // ── Layout Switcher ──
    window.switchLayout = function (mode, persist = true) {
      currentLayout = mode;
      if (persist) {
        localStorage.setItem("mca-catalog-layout", mode);
      }

      const gridEl = document.getElementById("articles-grid");
      const gridBtn = document.getElementById("layout-grid");
      const listBtn = document.getElementById("layout-list");

      if (!gridEl || !gridBtn || !listBtn) return;

      if (mode === "list") {
        gridEl.classList.add("list-view");
        listBtn.classList.add("active");
        gridBtn.classList.remove("active");
      } else {
        gridEl.classList.remove("list-view");
        gridBtn.classList.add("active");
        listBtn.classList.remove("active");
      }

      // Re-apply filters to align layouts
      applyFilters();
    };

    // ── Main Filter Applicator ──
    function applyFilters() {
      const cards = document.querySelectorAll("#articles-grid .article-card");
      let matchCount = 0;

      cards.forEach((card) => {
        const catMatch =
          currentCat === "all" ||
          card.getAttribute("data-category") === currentCat;
        const lvlMatch =
          currentLevel === "all" ||
          card.getAttribute("data-level") === currentLevel;
        const srchMatch =
          currentSearch === "" ||
          card.getAttribute("data-title").includes(currentSearch.toLowerCase());

        let tagMatch = currentTag === "all";
        if (!tagMatch) {
          const cleanCurTag = currentTag.toLowerCase().replace(/^#/, "");
          const cardCat = (card.getAttribute("data-category") || "").toLowerCase();
          const topDiv = card.querySelector(".article-card-top");
          if (topDiv) {
            const tags = Array.from(topDiv.querySelectorAll(".tag")).map((t) =>
              t.textContent.trim().toLowerCase().replace(/^#/, ""),
            );
            tagMatch = tags.includes(cleanCurTag) || cardCat === cleanCurTag;
          } else {
            tagMatch = cardCat === cleanCurTag;
          }
        }

        const matchesFilters = catMatch && lvlMatch && srchMatch && tagMatch;

        if (matchesFilters) {
          matchCount++;
          if (matchCount <= visibleLimit) {
            card.classList.remove("hidden");
            card.style.display = "";
          } else {
            card.classList.add("hidden");
            card.style.display = "none";
          }
        } else {
          card.classList.add("hidden");
          card.style.display = "none";
        }
      });

      const countEl = document.getElementById("visible-count");
      if (countEl) countEl.textContent = matchCount;

      const noResults = document.getElementById("no-results");
      if (noResults)
        noResults.style.display = matchCount === 0 ? "block" : "none";

      // Update Pagination UI
      const paginationContainer = document.getElementById(
        "pagination-container",
      );
      const loadMoreBtn = document.getElementById("load-more-btn");

      if (paginationContainer && loadMoreBtn) {
        if (matchCount > 6) {
          paginationContainer.style.display = "flex";

          const currentLoadedSpans =
            paginationContainer.querySelectorAll(".current-loaded");
          const totalMatchesSpans =
            paginationContainer.querySelectorAll(".total-matches");
          const activeContent = loadMoreBtn.querySelector(
            ".btn-active-content",
          );
          const loadedContent = loadMoreBtn.querySelector(
            ".btn-loaded-content",
          );

          currentLoadedSpans.forEach((span) => {
            span.textContent = Math.min(visibleLimit, matchCount);
          });
          totalMatchesSpans.forEach((span) => {
            span.textContent = matchCount;
          });

          if (visibleLimit >= matchCount) {
            loadMoreBtn.disabled = true;
            if (activeContent) activeContent.style.display = "none";
            if (loadedContent) loadedContent.style.display = "inline-flex";
            loadMoreBtn.classList.add("all-loaded");
          } else {
            loadMoreBtn.disabled = false;
            if (activeContent) activeContent.style.display = "inline-flex";
            if (loadedContent) loadedContent.style.display = "none";
            loadMoreBtn.classList.remove("all-loaded");
          }
        } else {
          paginationContainer.style.display = "none";
        }
      }
    }

    // ── Clear Tag Filters ──
    window.clearTagFilter = function () {
      currentTag = "all";
      visibleLimit = 6; // Reset pagination limit
      const tagLabel = document.getElementById("active-tag-label");
      if (tagLabel) tagLabel.style.display = "none";

      const url = new URL(window.location);
      url.searchParams.delete("tag");
      window.history.pushState({}, "", url);

      applyFilters();
    };

    // ── Bootstrap execution on load ──
    document.addEventListener("DOMContentLoaded", () => {
      // 1. Restore View Layout Mode
      const savedLayout = localStorage.getItem("mca-catalog-layout") || "grid";
      switchLayout(savedLayout, false);

      // 2. Initialize Counts and render sub-items list
      updateCategoryCounts();
      const currentLang = document.documentElement.lang || "es";
      renderSidebarSubItems(currentLang);

      // 3. Set up Language Mutation Observer to update sub-item titles when switched
      const langObserver = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (
            mutation.type === "attributes" &&
            mutation.attributeName === "lang"
          ) {
            const newLang = document.documentElement.lang || "es";
            renderSidebarSubItems(newLang);
          }
        });
      });
      langObserver.observe(document.documentElement, {
        attributes: true,
        attributeFilter: ["lang"],
      });

      // 4. URL Params handling (load tag/cat filters)
      const params = new URLSearchParams(window.location.search);
      const tag = params.get("tag");
      if (tag) {
        currentTag = tag;
        const tagLabel = document.getElementById("active-tag-label");
        const tagText = document.getElementById("active-tag-text");
        if (tagLabel && tagText) {
          tagText.textContent = tag;
          tagLabel.style.display = "inline-flex";
        }
      }

      const cat = params.get("cat");
      if (cat) {
        filterCat(null, cat);
      } else {
        applyFilters();
      }

      // 5. Click handler for level tags
      document.querySelectorAll("[data-filter-level]").forEach((btn) => {
        btn.addEventListener("click", () => {
          document
            .querySelectorAll("[data-filter-level]")
            .forEach((b) => b.classList.remove("active"));
          btn.classList.add("active");
          currentLevel = btn.getAttribute("data-filter-level");
          visibleLimit = 6; // Reset pagination limit
          applyFilters();
        });
      });

      // 6. Search bar input key listener
      const catalogSearch = document.getElementById("catalog-search");
      if (catalogSearch) {
        catalogSearch.addEventListener("input", () => {
          currentSearch = catalogSearch.value.trim();
          visibleLimit = 6; // Reset pagination limit
          applyFilters();
        });
      }

      // 7. Clickable tags inside card trigger filters dynamically
      document.querySelectorAll("#articles-grid .tag").forEach((tagEl) => {
        const text = tagEl.textContent.trim();
        if (text.startsWith("#")) {
          tagEl.style.cursor = "pointer";
          tagEl.title = "Filtrar por este tag";
          tagEl.addEventListener("click", (e) => {
            e.preventDefault();
            e.stopPropagation();
            const tagValue = text.substring(1);

            const url = new URL(window.location);
            url.searchParams.set("tag", tagValue);
            window.history.pushState({}, "", url);

            currentTag = tagValue;
            visibleLimit = 6; // Reset pagination limit
            const tagLabel = document.getElementById("active-tag-label");
            const tagText = document.getElementById("active-tag-text");
            if (tagLabel && tagText) {
              tagText.textContent = tagValue;
              tagLabel.style.display = "inline-flex";
            }
            applyFilters();
            window.scrollTo({ top: 0, behavior: "smooth" });
          });
        }
      });

      // 8. Click handler for load more button
      const loadMoreBtn = document.getElementById("load-more-btn");
      if (loadMoreBtn) {
        loadMoreBtn.addEventListener("click", () => {
          visibleLimit += 6;
          applyFilters();
        });
      }

      // 9. Synchronize filters with browser Back/Forward navigation
      window.addEventListener("popstate", (event) => {
        const params = new URLSearchParams(window.location.search);
        const cat = params.get("cat") || "all";
        if (typeof window.filterCat === "function") {
          window.filterCat(null, cat);
        }
      });
    });
  </script>
</Layout>
