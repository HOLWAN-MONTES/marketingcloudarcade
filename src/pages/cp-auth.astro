      <span data-lang="es">Artículo</span>
      <span data-lang="en">Article</span>
    </div>

    <div style="display:flex;align-items:flex-start;gap:1rem;flex-wrap:wrap;margin-bottom:1rem;">
      <span class="tag" style="--tag-color:#bd93f9;background:rgba(189,147,249,0.1);color:#bd93f9;border-color:rgba(189,147,249,0.2);">Cloud Pages</span>
          <span class="tag">#auth</span>
          <span class="level-badge advanced">x Advanced</span>
    </div>

    <h1 data-lang="es">Cloud Pages: Sistema de Login con Tokens</h1>
    <h1 data-lang="en">Cloud Pages: Token-Based Login System</h1>

    <div class="article-meta">
      <span class="article-meta-item">📅 <span data-lang="es">Actualizado</span><span data-lang="en">Updated</span>: Apr 2025</span>
      <span class="article-meta-item">⏱️ 8 min read</span>
      <span class="article-meta-item">👁️ <span data-random-views data-article-id="cp-auth">0</span> views</span>
    </div>
  </div>
