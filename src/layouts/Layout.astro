---
// src/layouts/Layout.astro
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import { categoryIconConfig } from '../config/icons.js';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<script is:inline define:vars={{ iconConfig: JSON.stringify(categoryIconConfig) }}>
  window.categoryIconConfig = JSON.parse(iconConfig);
  window.getCategoryIcon = function(category, size = 16) {
    const icon = window.categoryIconConfig[category];
    if (!icon) return '';
    return '<img src="' + icon.path + '" alt="' + icon.alt + '" style="width:' + size + 'px;height:' + size + 'px;vertical-align:middle;">';
  };
</script>

<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Base de conocimiento de Salesforce Marketing Cloud: SSJS, AMPscript, SQL, Automation Studio y más." />
		<link rel="icon" type="image/png" href="/assets/img/logo-favicon/favicon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		
		<link rel="stylesheet" href="/assets/css/main.css" />

		<!-- Prevent FOUC: hide non-active language before first paint -->
		<script is:inline>
			(function(){
				var lang = 'es';
				try { lang = localStorage.getItem('mca-lang') || 'es'; } catch(e){}
				var hide = lang === 'es' ? 'en' : 'es';
				document.documentElement.lang = lang;
				var s = document.createElement('style');
				s.id = 'lang-fouc';
				s.textContent = '[data-lang="' + hide + '"]{display:none!important}';
				document.head.appendChild(s);
			})();
		</script>

		<!-- Prevent FOUC: apply saved theme before first paint -->
		<script is:inline>
			(function(){
				try {
					var theme = localStorage.getItem("mca-theme") || "dark";
					document.documentElement.setAttribute("data-theme", theme);
				} catch(e){}
			})();
		</script>
	</head>
	<body>
		<!-- Reading progress -->
		<div id="reading-progress"></div>

		<!-- ════════════════ NAVBAR ════════════════ -->
		<Navbar />
		
		<!-- Update UI immediately after Navbar parses -->
		<script is:inline>
			(function(){
				try {
					// Update theme toggle button
					var theme = localStorage.getItem("mca-theme") || "dark";
					var btn = document.getElementById("theme-toggle");
					if (btn) btn.textContent = theme === "dark" ? "☀️" : "🌙";
					
					// Update language switch
					var lang = localStorage.getItem("mca-lang") || "es";
					var switchEl = document.getElementById("nav-lang-switch");
					if (switchEl) switchEl.checked = (lang === "en");
				} catch(e){}
			})();
		</script>

		<!-- ════════════════ CONTENT ════════════════ -->
		<slot />

		<!-- ════════════════ FOOTER ════════════════ -->
		<Footer />

		<!-- ════════════════ SEARCH OVERLAY ════════════════ -->
		<div id="search-overlay" class="search-overlay">
			<div class="search-modal">
				<div class="search-modal-input-wrap">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
				<input id="search-input-modal" class="search-modal-input" type="text" placeholder="Buscar artículos... / Search articles..." />
				<span style="font-family:var(--font-mono);font-size:0.7rem;color:var(--text-muted);">ESC</span>
				</div>
				<div id="search-results" class="search-results"></div>
			</div>
		</div>

		<!-- ════════════════ KONAMI TOAST ════════════════ -->
		<div id="konami-toast">🕹️ ¡CÓDIGO KONAMI! +9999 XP DESBLOQUEADOS</div>

		<!-- ════════════════ SCRIPTS ════════════════ -->
		<script src="/assets/js/main.js" is:inline></script>
		<script type="module" src="/assets/js/firebase-db.js" is:inline></script>
	</body>
</html>
