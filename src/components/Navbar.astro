---
// src/components/Navbar.astro
---

<nav class="navbar">
  <a class="navbar-logo" href="/">
    <div class="navbar-logo-icon">
      <img src="/assets/img/logo-favicon/favicon.png" alt="Logo" style="width:24px;height:24px;object-fit:contain;" />
    </div>
    <div class="navbar-logo-text">MARKETING CLOUD<span>ARCADE</span></div>
  </a>
  <div class="navbar-search">
    <span class="navbar-search-icon">🔍</span>
    <input id="nav-search" type="text" placeholder="Search... (Ctrl+K)" readonly data-open-search />
  </div>
  <div class="navbar-spacer"></div>
  <ul class="navbar-links">
    <li><a href="/" data-lang="es">Inicio</a><a href="/" data-lang="en">Home</a></li>
    <li><a href="/catalog" data-lang="es">Catálogo</a><a href="/catalog" data-lang="en">Catalog</a></li>
    <li><a href="/catalog?cat=ssjs">SSJS</a></li>
    <li><a href="/catalog?cat=ampscript">AMPscript</a></li>
    <li><a href="/catalog?cat=sql">SQL</a></li>
    <li><a href="/catalog?cat=innovations" data-lang="es">Innovaciones</a><a href="/catalog?cat=innovations" data-lang="en">Innovations</a></li>
    <li><a href="/catalog?cat=mc-next" class="nav-next-badge" title="Marketing Cloud Next & Data Cloud"><span class="next-spark">✨</span> MC NEXT</a></li>
    <li><a href="/about" data-lang="es">Sobre mí</a><a href="/about" data-lang="en">About</a></li>
  </ul>
  <div class="navbar-actions">
    <div class="nav-arcade-toggle">
      <input type="checkbox" id="nav-lang-switch">
      <label for="nav-lang-switch" class="arcade-track">
        <div class="arcade-slider"></div>
        <span class="lang-text text-es">ES</span>
        <span class="lang-text text-en">EN</span>
      </label>
    </div>
    <button class="btn-icon" id="theme-toggle" title="Toggle theme">🌙</button>
  </div>
</nav>
